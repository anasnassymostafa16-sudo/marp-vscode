---
marp: true
size: 16:9
theme: default
paginate: true
style: |
  /* ---------- CSS VARIABLES (tweak here) ---------- */
  :root{
    --accent1:#00f0ff;      /* neon cyan */
    --accent2:#ff00c1;      /* neon magenta */
    --dark:#0b0e17;
    --grid:#00f0ff22;
    --blur:12px;
    --speed:1.2s;
  }

  /* ---------- GLOBAL SET-UP ---------- */
  section{
    background:radial-gradient(ellipse at center, #101525 0%, var(--dark) 100%);
    color:#fff;
    font-family:'Segoe UI',system-ui,sans-serif;
    overflow:hidden;
  }
  h1,h2,h3{ margin:0; font-weight:700; }
  p{ margin:.3em 0; }

  /* ---------- 3-D CANVAS STAGE ---------- */
  section::before,
  section::after{
    content:'';
    position:absolute;
    inset:0;
    pointer-events:none;
  }
  section::before{  /* star dust */
    background-image:
      radial-gradient(1.5px 1.5px at 20% 30%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 40% 70%, #fff, transparent),
      radial-gradient(1px 1px at 90% 10%, #fff, transparent);
    background-size:300% 300%;
    animation: drift var(--speed) linear infinite;
  }
  section::after{  /* perspective grid */
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:60px 60px;
    transform: perspective(600px) rotateX(75deg) translateZ(-120px);
    opacity:.4;
  }

  @keyframes drift{
    from{transform:translateY(0)}
    to{transform:translateY(-100px)}
  }

  /* ---------- GLASS CARD ---------- */
  .glass{
    background:rgba(255,255,255,.06);
    backdrop-filter:blur(var(--blur));
    border:1px solid rgba(255,255,255,.15);
    border-radius:1.2rem;
    padding:2.2rem 2.8rem;
    box-shadow:0 0 2rem rgba(0,240,255,.35);
    transform-style:preserve-3d;
    animation:slideIn var(--speed) cubic-bezier(.2,1,.2,1) both;
  }
  @keyframes slideIn{
    from{opacity:0; transform:translateZ(-180px) rotateX(-25deg)}
    to{opacity:1; transform:translateZ(0) rotateX(0)}
  }

  /* ---------- ACCENT TEXT ---------- */
  .a1{ color:var(--accent1); }
  .a2{ color:var(--accent2); }

  /* ---------- LAYERED BULLETS ---------- */
  ul.layers{
    list-style:none;
    padding-left:0;
    margin-top:1.2rem;
  }
  ul.layers li{
    position:relative;
    padding-left:2.2rem;
    margin:.6rem 0;
    transform: translateX(60px);
    animation: pop .5s forwards;
    animation-delay:calc(var(--i)*.15s);
  }
  ul.layers li::before{
    content:'';
    position:absolute;
    left:0; top:.1em;
    width:1.3rem; height:1.3rem;
    background:var(--accent1);
    clip-path:polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  @keyframes pop{ to{transform:translateX(0)} }

  /* ---------- TITLE SHINE ---------- */
  .shine{
    background:linear-gradient(110deg, var(--accent1), var(--accent2));
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:shine 3s linear infinite;
    background-size:200% auto;
  }
  @keyframes shine{ to{background-position:200% center} }
---

